# Bot Identity & Runtime
BOT_NAME="Weabot Ruby"
BOT_PREFIX="!"
BOT_MODE="public"
OWNER_NUMBERS="6281234567890"

# Transport: bridge (WhatsApp Web Multi-Device) | cloud_api | memory
TRANSPORT_MODE="bridge"
AUTH_FOLDER="./auth_info"
PAIRING_NUMBER=""
PRINT_QR="true"

# Dispatcher Automation Limits
PER_JID_INTERVAL="1.2"
MAX_RETRY_ATTEMPTS="3"

# Built-in REST API & Webhook Server
API_ENABLED="true"
API_HOST="0.0.0.0"
API_PORT="4567"
API_KEY="change-this-api-key"
WEBHOOK_URL=""
WEBHOOK_SECRET=""

# Optional Meta Cloud API Credentials (when TRANSPORT_MODE=cloud_api)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
