#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require_relative "../lib/bot"

command = ARGV.shift || "start"
overrides = {}

OptionParser.new do |opts|
  opts.on("-m", "--mode MODE", String, "Transport mode (bridge|cloud_api|memory)") { |v| overrides[:transport_mode] = v.to_sym }
  opts.on("-p", "--pairing PHONE", String, "Phone number for 8-digit pairing code") { |v| overrides[:pairing_number] = v }
  opts.on("--port PORT", Integer, "REST API port") { |v| overrides[:api_port] = v }
  opts.on("--no-api", "Disable built-in REST API server") { overrides[:api_enabled] = false }
end.parse!(ARGV)

case command
when "start"
  cfg = WeabotRuby::Config.new(overrides)
  puts "Starting #{cfg.bot_name} (mode=#{cfg.transport_mode}, prefix=#{cfg.prefix}, plugins=#{Dir.glob(File.join(cfg.plugins_dir, '*.rb')).size})"
  WeabotRuby::Bot.new(cfg).start(blocking: true)
when "pairing"
  phone = ARGV.shift || overrides[:pairing_number]
  abort "Usage: weabot pairing <6281234567890>" if phone.to_s.empty?
  cfg = WeabotRuby::Config.new(overrides.merge(pairing_number: phone, print_qr: false))
  WeabotRuby::Bot.new(cfg).start(blocking: true)
when "version"
  puts "weabot-ruby (baileys_rec #{BaileysRec::VERSION})"
else
  puts <<~HELP
    Weabot Ruby CLI (powered by baileys_rec #{BaileysRec::VERSION})

    Usage:
      bin/weabot start [--mode bridge|cloud_api|memory] [--port 4567]
      bin/weabot pairing <6281234567890>
      bin/weabot version
  HELP
end
